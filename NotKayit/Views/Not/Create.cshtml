@model NotKayit.Models.ViewModels.NotCreateViewModel

@{
    ViewData["Title"] = "Not Ekle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content">
    <div class="container-fluid">

        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="card card-success">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-plus-circle mr-2"></i> Öğrenciye Not Ekle
                        </h3>
                    </div>

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="OgrenciTmlId" type="hidden" />

                        <div class="card-body">

                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="form-group">
                                <label>Öğrenci</label>
                                <input value="@Model.OgrenciAdSoyad" class="form-control" readonly />
                            </div>

                            <div class="form-group">
                                <label asp-for="DersId"></label>
                                <select asp-for="DersId" asp-items="Model.Dersler" class="form-control">
                                    <option value="">-- Ders Seçiniz --</option>
                                </select>
                                <span asp-validation-for="DersId" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="NotKodTmlId"></label>
                                <select asp-for="NotKodTmlId" asp-items="Model.NotTurleri" class="form-control">
                                    <option value="">-- Not Türü Seçiniz --</option>
                                </select>
                                <span asp-validation-for="NotKodTmlId" class="text-danger"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Deger"></label>
                                <input asp-for="Deger" type="number" step="0.01" class="form-control" placeholder="Örn: 85" />
                                <span asp-validation-for="Deger" class="text-danger"></span>
                            </div>

                        </div>

                        <div class="card-footer d-flex justify-content-between">
                            <a asp-controller="Ogrenci" asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left mr-1"></i> Listeye Dön
                            </a>

                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save mr-1"></i> Kaydet
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}